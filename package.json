{
  "name": "dsh-auto-code-check",
  "description": "Multi-language auto code review plugin for DeepSeek Harness — runs tsc, clang-tidy, cppcheck, ruff, mypy on edit/write and reports diagnostics.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepare": "tsc"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0",
    "@deepseek-ai/dsh-agent": ">=0.1.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.0",
    "@deepseek-ai/cordis": ">=0.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "typescript": "^5.6.0"
  }
}
